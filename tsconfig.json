{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  "include": ["src", "scripts/devFresh.ts", "scripts/devFresh.bun.test.ts", "scripts/releaseNative.ts", "scripts/releaseNative.bun.test.ts"],
  // Electrobun glue: `electrobun/main` resolves only from the generated Hutch devkit (src/native/main.ts header), as does its updater adapter.
  "exclude": ["src/native/main.ts", "src/native/updater.ts"]
}
