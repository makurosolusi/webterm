{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  "include": ["src", "scripts/devFresh.ts", "scripts/devFresh.bun.test.ts", "scripts/releaseNative.ts", "scripts/releaseNative.bun.test.ts", "scripts/smoke.capabilities*.ts", "scripts/test.*.ts", "scripts/testGuard.*.ts", "scripts/vitestGuard.ts", "scripts/bunTestGuard.ts"],
  // Electrobun glue: `electrobun/main` resolves only from the generated Hutch devkit (src/native/nativeApp.ts header), as does its
  // updater adapter. main.ts is excluded because its dynamic import of nativeApp.ts would pull the devkit in; its router is nativeRoute.ts.
  "exclude": ["src/native/main.ts", "src/native/nativeApp.ts", "src/native/updater.ts"]
}
