# Opsional: tanpa file ini app tetap jalan. Hanya kunci bootstrap; sisanya di Settings > Environment (env tetap sah, nilai tersimpan di Settings menang).
HOST=127.0.0.1
# PORT=8700
# WEBTERM_DATA_DIR=   # default ~/.webterm-server (path absolut; `~` tidak diperluas di .env)
# WEBTERM_TOKEN=      # kosong: loopback tanpa token; non-loopback dibangkitkan otomatis di <data dir>/secrets
# WEBTERM_ENV_SETTINGS=off  # `off` mengunci Settings > Environment: override tersimpan diabaikan
# WEBTERM_ALLOW_TOKEN_MINT=1         # hanya persis `1`: mint capability control (butuh WEBTERM_TOKEN)
# WEBTERM_STRICT_HOOK_AUTH=1         # hanya persis `1`: hook claude wajib verifikasi token node
