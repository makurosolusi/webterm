# Bind host. Loopback (localhost/127.0.0.1/::1) jalan tanpa token; host non-loopback wajib WEBTERM_TOKEN.
HOST=localhost
# Port HTTP + WebSocket (default 8700).
PORT=8700
# Root token transport. Kosong + loopback = tanpa token (default dev). Non-loopback wajib diisi.
# WEBTERM_TOKEN=
# Control API (`/api/control/*`) memakai capability `wcap_*`; mint hanya aktif bila flag ini 1
# DAN WEBTERM_TOKEN diset. Token root tetap satu-satunya cara mem-mint.
# WEBTERM_ALLOW_TOKEN_MINT=0
# Hook claude: wajib verifikasi token node + path transcript sebelum menulis status (default 0).
# WEBTERM_STRICT_HOOK_AUTH=0
# Root direktori tambahan yang boleh dipakai `cwd` spawn control, dipisah `:` (default: home + data dir).
# WEBTERM_CONTROL_CWD_ROOTS=
