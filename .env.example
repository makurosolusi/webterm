# Contoh konfigurasi. Bun memuat `.env` dari cwd secara otomatis, untuk dev server maupun
# binary. Karena itu jangan menaruh secret yang tidak ingin diwarisi di file ini.
# Salin ke `.env` lalu `chmod 600 .env`.

# Bind host. Loopback (localhost/127.0.0.1/::1) jalan tanpa token; host non-loopback wajib
# WEBTERM_TOKEN.
HOST=localhost
# Port HTTP + WebSocket (default 8700).
PORT=8700

# Root token transport. Sengaja TIDAK diisi di sini: token harus diekspor eksplisit.
# Kosong + loopback = tanpa token (default dev). Non-loopback wajib diisi.
# WEBTERM_TOKEN=

# Approval manusia (`/api/approvals/*`) menolak loopback tanpa token secara default.
# Set 1 hanya untuk demo lokal sekali pakai: siapa pun di mesin yang sama bisa approve.
# WEBTERM_ALLOW_LOOPBACK_APPROVAL=0

# Control API (`/api/control/*`) memakai capability `wcap_*`; mint hanya aktif bila flag ini 1
# DAN WEBTERM_TOKEN diset. Token root tetap satu-satunya cara mem-mint.
# WEBTERM_ALLOW_TOKEN_MINT=0

# Hook claude: wajib verifikasi token node + path transcript sebelum menulis status (default 0).
# WEBTERM_STRICT_HOOK_AUTH=0

# Root direktori tambahan yang boleh dipakai `cwd` spawn control, dipisah `:` (default: home + data dir).
# WEBTERM_CONTROL_CWD_ROOTS=

# Ledger P2 (project/task/event/usage). off (default) | shadow | on.
# WEBTERM_LEDGER=off

# Telegram channel (P5). Butuh ledger hidup + secret webhook. Nilai yang dibaca kode: on.
# WEBTERM_TELEGRAM=off
# WEBTERM_TELEGRAM_WEBHOOK_SECRET=
# Token bot. Legacy `TELEGRAM_BOT_TOKEN` juga diterima; jangan taruh di repo.
# WEBTERM_TELEGRAM_BOT_TOKEN=

# Throttle auth-failure webhook memakai alamat socket peer. Di belakang reverse proxy semua
# request punya alamat proxy yang sama, jadi 30 secret salah bisa memblokir delivery sah selama
# 60 detik. `on` (default `off`) membuat key throttle memakai entri PERTAMA `x-forwarded-for`
# (hanya bila berupa literal IPv4/IPv6 valid; selain itu jatuh ke alamat socket).
# PENTING: aktifkan HANYA bila proxy tepercaya menimpa `x-forwarded-for`. Kalau klien bisa
# mengirim header itu langsung, penyerang memutar nilai header dan melewati throttle.
# WEBTERM_TRUST_PROXY=off

# Worker run + control plane orchestrator (`/api/orchestrator/run|bootstrap|assign`). `on` untuk aktif.
# WEBTERM_ORCHESTRATOR_RUN=off
# Wajibkan approval ledger `approved` untuk setiap `/api/orchestrator/run` (`approvalId` +
# `approvalDigest`). Default `off`: field approval tetap opsional, tapi bila dikirim tetap
# di-consume tepat sekali sebelum worktree/PTY.
# WEBTERM_RUN_REQUIRE_APPROVAL=off

# File+git truth untuk memory; gate `/api/memory/export|rebuild`.
# WEBTERM_MEMORY_FILES=off
# Root file memory; default `<dataDir>/memory`, hanya path absolut yang dipakai.
# WEBTERM_MEMORY_DIR=

# Proyeksi portfolio + pause/resume/priority di `/api/central/*`. `on` untuk aktif.
# WEBTERM_CENTRAL=off
# WEBTERM_CENTRAL_MEMORY=off

# Chat panel central (S0). Membutuhkan WEBTERM_CENTRAL=on. Runtime `mock` hanya untuk demo/tes;
# `opencode` menjalankan CLI `opencode run --format json` tanpa `--auto` (tool mutasi di-deny);
# `claude`/`codex` belum diimplementasikan pada slice ini. Default off.
# WEBTERM_CENTRAL_CHAT=off
# WEBTERM_CENTRAL_TELEGRAM=off  # Requires WEBTERM_CENTRAL_CHAT=on + a bound private chat; real delivery is not yet verified.
# WEBTERM_CENTRAL_RUNTIME=off
# Model untuk runtime `opencode` (default opencode/deepseek-v4.1-flash-free).
# WEBTERM_CENTRAL_MODEL=
# Binary opencode yang dipakai runtime (default `opencode` di PATH).
# WEBTERM_OPENCODE_BIN=

# Loop otonom pusat (P3). Default `off`. `on` MENJALANKAN WORKER NYATA: tiap interval ia
# menjalankan SATU item plan berstatus `assigned` (seq terkecil) lewat route yang sama dengan
# POST /api/orchestrator/run, tanpa membuat task/plan dan tanpa menyetujui approval.
# Butuh WEBTERM_CENTRAL_AUTONOMY=on + ledger hidup (`WEBTERM_LEDGER=on`) +
# `WEBTERM_ORCHESTRATOR_RUN=on`; jika salah satu tidak ada, boot menolak dan hanya warning.
# Proyek vendor `paused` dan plan `completed`/`abandoned` dilewati; 3 kegagalan berturut-turut
# membuat proyek di-skip sampai ada sukses atau status proyek berubah.
# WEBTERM_CENTRAL_AUTONOMY=off

# Central planner proposal gate. Requires both planner=on and tools=write.
# WEBTERM_CENTRAL_PLANNER=off
# WEBTERM_CENTRAL_TOOLS=read

# Master kill switch seluruh runtime kanal (webhook + binding API + sender). Hanya `on|off`
# yang diimplementasi. Kosong/`on` = perilaku lama; `off` = mati total walau
# WEBTERM_TELEGRAM=on; nilai lain (termasuk `readonly`/`control` yang masih direncanakan)
# fail-closed -> off + satu warning. Store kanal berupa JSON di data dir, tanpa migrasi SQL v4.
# WEBTERM_CHANNELS=off

# --- Central Agent v2 (semua default OFF; butuh WEBTERM_LEDGER=on, restart wajib setelah ubah) ---
# Mode agen central: off | propose (kartu approval per aksi) | auto (dalam amplop). Menentukan
# plafon level kontrol dan membuka tool agent.*/task.run. Butuh tools=write + planner + orchestrator run.
# WEBTERM_CENTRAL_AGENTS=off
# Batas per turn: langkah tool, giliran runtime, dinding waktu (ms), token.
# WEBTERM_CENTRAL_MAX_STEPS=2
# WEBTERM_CENTRAL_TURN_STEPS=12
# WEBTERM_CENTRAL_TURN_WALL_MS=120000
# WEBTERM_CENTRAL_TURN_TOKENS=60000
# Budget harian (UTC); 0 = tanpa batas.
# WEBTERM_CENTRAL_DAILY_TOKENS=1000000
# WEBTERM_CENTRAL_DAILY_SPAWNS=20
# WEBTERM_CENTRAL_DAILY_COST_MICROS=0
# Tool baca (project/node/task) dan lanjut turn. Butuh WEBTERM_CENTRAL_TOOLS.
# WEBTERM_CENTRAL_READ_TOOLS=off
# Konteks: ringkas percakapan ke checkpoint (butuh runtime opencode); jendela model untuk rotasi sesi.
# WEBTERM_CENTRAL_CHECKPOINT=off
# WEBTERM_CENTRAL_CONTEXT_WINDOW=128000
# Cara memanggil tool: text (parse teks) | opencode (tool native).
# WEBTERM_CENTRAL_TOOL_BRIDGE=text
# Skill central dari <dataDir>/central/skills; usul skill baru perlu approval manusia.
# WEBTERM_CENTRAL_SKILLS=off
# WEBTERM_CENTRAL_SKILL_PROPOSE=off
# Mailbox pesan ke worker (butuh WEBTERM_CENTRAL_AGENTS).
# WEBTERM_AGENT_MAIL=off
# Knowledge base project di <dataDir>/knowledge.db; graphify butuh binary graphify di PATH.
# WEBTERM_KNOWLEDGE=off
# WEBTERM_KNOWLEDGE_GRAPHIFY=off
# Satu bot dengan topic per project (butuh Telegram + WEBTERM_CHANNELS); tombol approval Telegram.
# WEBTERM_CENTRAL_BOTS=off
# WEBTERM_CHANNEL_APPROVAL_BUTTONS=off
# Autonomy reliabel: dispatcher non-blocking, wake, breaker per item (butuh WEBTERM_CENTRAL_AUTONOMY).
# WEBTERM_CENTRAL_RELIABILITY=off
# WEBTERM_CENTRAL_MAX_INFLIGHT=3
# Worker non-claude yang diam selama ini dengan diff tak kosong = kandidat selesai (ms).
# WEBTERM_AGENT_IDLE_DONE_MS=45000
# Embedding memori. Isi memori DIKIRIM ke endpoint ini; kosong = pencarian leksikal saja.
# WEBTERM_EMBED_URL=
# WEBTERM_EMBED_MODEL=
# Panel kontrol di UI hanya dibangun bila env build ini `on` (default off): VITE_WEBTERM_CENTRAL_CHAT=on
