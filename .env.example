# Contoh konfigurasi. Bun memuat `.env` dari cwd secara otomatis, untuk dev server maupun
# binary. Karena itu jangan menaruh secret yang tidak ingin diwarisi di file ini.
# Salin ke `.env` lalu `chmod 600 .env`.

# Bind host. Loopback (localhost/127.0.0.1/::1) jalan tanpa token; host non-loopback wajib
# WEBTERM_TOKEN.
HOST=localhost
# Port HTTP + WebSocket (default 8700).
PORT=8700

# Root token transport. Sengaja TIDAK diisi di sini: token harus diekspor eksplisit.
# Kosong + loopback = tanpa token (default dev). Non-loopback wajib diisi.
# WEBTERM_TOKEN=

# Approval manusia (`/api/approvals/*`) menolak loopback tanpa token secara default.
# Set 1 hanya untuk demo lokal sekali pakai: siapa pun di mesin yang sama bisa approve.
# WEBTERM_ALLOW_LOOPBACK_APPROVAL=0

# Control API (`/api/control/*`) memakai capability `wcap_*`; mint hanya aktif bila flag ini 1
# DAN WEBTERM_TOKEN diset. Token root tetap satu-satunya cara mem-mint.
# WEBTERM_ALLOW_TOKEN_MINT=0

# Hook claude: wajib verifikasi token node + path transcript sebelum menulis status (default 0).
# WEBTERM_STRICT_HOOK_AUTH=0

# Root direktori tambahan yang boleh dipakai `cwd` spawn control, dipisah `:` (default: home + data dir).
# WEBTERM_CONTROL_CWD_ROOTS=

# Ledger P2 (project/task/event/usage). off (default) | shadow | on.
# WEBTERM_LEDGER=off

# Telegram channel (P5). Butuh ledger hidup + secret webhook. Nilai yang dibaca kode: on.
# WEBTERM_TELEGRAM=off
# WEBTERM_TELEGRAM_WEBHOOK_SECRET=
# Token bot. Legacy `TELEGRAM_BOT_TOKEN` juga diterima; jangan taruh di repo.
# WEBTERM_TELEGRAM_BOT_TOKEN=

# Rencana, belum dibaca kode mana pun: gate adapter kanal off|shadow|on.
# WEBTERM_CHANNELS=off
