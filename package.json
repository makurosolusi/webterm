{
  "name": "webterm",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/server/index.ts",
    "dev:fresh": "bun scripts/devFresh.ts",
    "build": "vite build && bun scripts/embedDist.ts",
    "build:binary": "bun run build && bun build --compile --define \"process.env.NODE_ENV='production'\" --no-compile-autoload-bunfig --external vite --outfile webterm src/server/index.ts",
    "build:native": "vite build && electrobun build --env=stable",
    "build:native:cef": "WEBTERM_NATIVE_CEF=1 npm run build:native",
    "dev:native": "vite build && electrobun dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:changed": "vitest --changed --run",
    "test:bun": "HOME=$(mktemp -d \"${TMPDIR:-/tmp}/webterm-home.XXXXXX\") bun test --no-env-file $(find src/server src/native scripts -name '*.bun.test.ts' ! -name '*.real.bun.test.ts' | sort) && R=$(find src/server -name '*.real.bun.test.ts' | sort) && { [ -z \"$R\" ] || bun test --no-env-file $R; }"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@anthropic-ai/sdk": "1.6.0",
    "@ghostery/adblocker": "^2.20.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@puppeteer/browsers": "^3.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode-elements/react-elements": "2.4.0",
    "@vscode/codicons": "0.0.45",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "electrobun": "^2.0.6",
    "lucide-react": "^1.62.0",
    "marked": "^18.1.2",
    "marked-footnote": "^1.4.0",
    "modern-screenshot": "^4.7.0",
    "monaco-editor": "^0.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
