{
  "name": "webterm",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/server/index.ts",
    "build": "vite build && bun scripts/embedDist.ts",
    "build:binary": "bun run build && bun build --compile --define \"process.env.NODE_ENV='production'\" --external vite --outfile webterm src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.62.0",
    "marked": "^18.1.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
