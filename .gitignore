dist/
/webterm
*.log
.DS_Store
.env
.env.*
!.env.example
# lockfile repo ini bun.lock; package-lock.json hanya lahir kalau npm dipakai keliru
package-lock.json
# git worktrees created by agent tooling; the rest of .claude/ may hold shared project settings
.claude/worktrees/
# ekspor cookie browser = sesi login aktif, setara secret; jangan pernah ter-commit (Rule 7)
cookies.txt
*.cookies.txt
*cookies*.txt
# Well-known secret files (Rule 7). Sources: github/gitignore Node.gitignore (.env, .env.*,
# !.env.example) and Android.gitignore (*.jks, *.keystore); gitleaks default config rules
# `pkcs12-file` (*.p12, *.pfx) and `private-key` (PEM keys, ssh id_*). Same list as
# src/server/repoHygiene.ts, which guards workspace repos at runtime.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
credentials.json
service-account*.json
.aws/
.gcp/
# Written by scripts/embedDist.ts on every `bun run build`; a fresh tree uses distAssets.generated.d.ts
src/server/distAssets.generated.ts
# Electrobun native app (npm run build:native): Hutch devkit/lock state, build and release output
.hutch/
.cottontail-tmp/
hutch.lock
/build/
/artifacts/
